# Public origin this service answers on. Instagram fetches the card from here
# itself, so it must be reachable from the internet over https.
BASE_URL=https://daily-pause.up.railway.app
PORT=3000

# Shared secret for the write endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=

# The Page, and the permanent Page access token. Scopes needed:
#   pages_show_list pages_read_engagement pages_read_user_content
#   pages_manage_posts instagram_basic instagram_content_publish
FB_PAGE_ID=153181431219218
FB_PAGE_TOKEN=

# The connected Instagram Business account. Find it with:
#   GET /v21.0/<FB_PAGE_ID>?fields=instagram_business_account
IG_USER_ID=

TIMEZONE=Europe/London

# Minutes Instagram trails Facebook. Facebook posts can be cancelled in
# Business Suite before they go; Instagram cannot be unsent. A delay here makes
# the Facebook queue a proof-read for both. 0 posts them together.
IG_DELAY_MINUTES=0

DATA_DIR=./data
TICK_MS=30000

# Runs everything except the Graph calls.
DRY_RUN=
